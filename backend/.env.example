PORT=3000
# URL pública del backend (ej. túnel ngrok) para webhooks y URLs de retorno
PUBLIC_URL=
# Ruta al JSON de la cuenta de servicio de Firebase (NO subir a Git)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Solo credenciales de PRUEBA
MP_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Credenciales compartidas de coturn; el backend genera credenciales temporales por llamada.
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
